generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String?   @unique
  fullName     String
  passwordHash String
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  roleId       String
  isActive     Boolean   @default(true)
  avatarPath   String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  nameAr      String
  nameEn      String
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]

  @@index([key])
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

model Setting {
  key   String @id
  value String
}

model Department {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  natureAllowancePct Float?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employees Employee[]

  // future relation columns (branches, cost centers, …) slot in here
}

model Employee {
  id                String    @id @default(cuid())
  code              String    @unique // كود الموظف — natural key for import upserts
  name              String // اسم الموظف
  insuranceNo       String? // الرقم التأمينى
  nationalId        String? // الرقم القومى
  grade             String? // الدرجة
  gradeDate         DateTime? // تاريخ الدرجة
  birthDate         DateTime? // تاريخ الميلاد
  permanentDate     DateTime? // تاريخ التثبيت
  hireDate          DateTime? // تاريخ التعيين
  qualification     String? // المؤهل
  qualificationYear Int? // سنة المؤهل
  fileOriginalName  String? // attached work file — name shown to the user
  fileStoredName    String? // attached work file — unique name inside the files folder
  fileSize          Int? // attached work file — bytes
  fileLinkedAt      DateTime? // attached work file — when it was linked/replaced
  contractType      String? // نوع التعاقد (free text — permanent, temporary, …)
  departmentId      String? // القسم — soft link to Department; unlinking a department nulls this
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leaves            Leave[]
  status            String      @default("active") // الحالة الوظيفية — مفتاح من كتالوج الحالات (نشط/معاش/وفاة/استقالة…)
  statusHistory     EmployeeStatusHistory[]
  rehiredFromId     String? // عند إعادة التعيين بعقد جديد: يشير هذا الملف إلى الملف الأصلي السابق
  rehiredFrom       Employee? @relation("Rehire", fields: [rehiredFromId], references: [id], onDelete: SetNull)
  rehiredTo         Employee[] @relation("Rehire")
  payroll           PayrollEntry[]
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model EmployeeStatusHistory {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromStatus String // الحالة قبل التغيير
  toStatus   String // الحالة الجديدة
  reason     String? // سبب التغيير (استقالة، بلوغ المعاش، وفاة…)
  changedBy  String? // اسم المستخدم الذي نفّذ التغيير
  changedAt  DateTime @default(now())

  @@index([employeeId])
  @@index([changedAt])
}

model Leave {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             String // نوع الإجازة — مفتاح من كتالوج أنواع الإجازات (قانون العمل المصري 12/2003 وغيره)
  startDate        DateTime // تاريخ بداية الإجازة
  endDate          DateTime // تاريخ نهاية الإجازة (شامل)
  daysCount        Int // عدد أيام الإجازة (شامل طرفي الفترة)
  year             Int // السنة الإدارية المُحتسَبة من تاريخ البدء
  reason           String? // سبب الإجازة / ملاحظات الإدارة
  status           String    @default("pending") // pending | approved | rejected
  fileOriginalName String? // المستند الموثَّق — الاسم الظاهر للمستخدم
  fileStoredName   String? // المستند الموثَّق — الاسم الفريد داخل مجلد ملفات الإجازات
  fileSize         Int? // المستند الموثَّق — الحجم بالبايت
  fileLinkedAt     DateTime? // المستند الموثَّق — وقت الرفع/الاستبدال
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([employeeId])
  @@index([type])
  @@index([status])
  @@index([year])
}

model PayrollBatch {
  id           String         @id @default(cuid())
  type         String // salary | incentive | other — يُستنتج من اسم الملف
  month        Int
  year         Int
  period       String // "2026-09" — مفتاح الشهر
  originalName String
  storedName   String
  size         Int
  pageCount    Int
  uploadedAt   DateTime       @default(now())
  entries      PayrollEntry[]

  @@index([type, period])
}

model PayrollEntry {
  id              String        @id @default(cuid())
  batchId         String
  batch           PayrollBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type            String
  month           Int
  year            Int
  period          String
  page            Int // رقم صفحة الظرف داخل ملف الكشف الأصلي
  basicSalary     Float?
  totalEarned     Float?
  totalDeductions Float?
  netSalary       Float?
  sourceText      String? // النص المُستخرج من الظرف (للأرشفة والفحص)
  createdAt       DateTime      @default(now())

  @@index([employeeId, type, period])
  @@index([period])
}
