{
  "name": "hr-system",
  "version": "1.0.0",
  "description": "نظام إدارة الموارد البشرية — HR System desktop app",
  "main": "./out/main/index.js",
  "author": "HR System",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "prisma:generate": "prisma generate",
    "prisma:snapshot": "node scripts/prisma-snapshot.mjs",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.1.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/tajawal": "^5.1.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.104.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.11.0",
    "i18next": "^23.16.0",
    "lucide-react": "^0.452.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.2",
    "react-router-dom": "^6.27.0",
    "sonner": "^1.5.0",
